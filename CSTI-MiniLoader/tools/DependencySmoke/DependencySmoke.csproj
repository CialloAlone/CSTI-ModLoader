<Project Sdk="Microsoft.NET.Sdk">

  <!--
    离线依赖冒烟测试（不参与 mod 本体编译；mod 的 csproj 已 Compile Remove tools\**）。
    目的：在没有 adb / 真机的情况下，用真实依赖在 .NET 8 上验证：
      1) LZ4Codec.Decode(bytes,0,len,buf,0,bufLen,true) 这个 7 参重载可用且往返正确；
      2) LitJson + 移植版自己的 StringMapper/MapperObject 能解析真实 .modArch_V3 的 JsonsBLK；
      3) NAudio WaveFileReader/ReadNextSampleFrame（WAV 音频链路）可用；
      4) 真实 .modArch_V3 的容器分帧 / ImgBLK 图片数据的真实格式（raw 还是 PNG/JPG）。
    运行：dotnet run -c Release (在工作目录 tools\DependencySmoke 下)；可附带一个 .modArch_V3 路径参数
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DependencySmoke</AssemblyName>
    <RootNamespace>DependencySmoke</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS8632;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LitJson" Version="0.19.0" />
    <PackageReference Include="lz4net" Version="1.0.15.93" />
    <PackageReference Include="NAudio" Version="1.10.0" />
  </ItemGroup>

  <!-- 直接复用移植工程里的纯托管解析代码（不含 Unity/IL2CPP 依赖的那几个文件） -->
  <ItemGroup>
    <Compile Include="..\..\LoadUtil\KVProvider.cs" />
    <Compile Include="..\..\LoadUtil\StringMapper.cs" />
    <Compile Include="..\..\LoadUtil\MapperObject.cs" />
  </ItemGroup>

</Project>
